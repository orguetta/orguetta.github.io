---
/**
 * Shared site footer for every guetta.tech property.
 * Slot (default): an optional extra line, for example an RSS link.
 */
import { BRAND, NAV, PRIMARY_NAV, SOCIALS, localizeHref } from "../navigation";

const site = Astro.site;
const year = new Date().getFullYear();

const primary = PRIMARY_NAV.map(link => ({
  ...link,
  href: localizeHref(link.href, site),
}));

const legal = [
  { label: "Privacy", href: localizeHref(NAV.privacy, site) },
  { label: "Security", href: localizeHref(NAV.security, site) },
];
---

<footer class="site-footer">
  <div class="inner">
    <div class="columns">
      <div>
        <p class="g-label">Site</p>
        <ul>
          {primary.map(link => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="g-label">Elsewhere</p>
        <ul>
          {SOCIALS.map(link => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="g-label">Contact</p>
        <ul>
          <li>
            <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>
          </li>
          {legal.map(link => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="bottom">
      <p>
        © {year} {BRAND.name}
      </p>
      <slot />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    background: var(--surface-1);
  }

  .inner {
    width: min(100% - 2rem, var(--content-width));
    margin-inline: auto;
    padding: var(--space-7) 0 var(--space-6);
  }

  .columns {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
  }

  .columns .g-label {
    margin: 0 0 var(--space-3);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    font-size: 0.9375rem;
  }

  li {
    margin: 0;
  }

  ul a {
    color: var(--text-2);
  }

  ul a:hover {
    color: var(--signal);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-3);
  }

  .bottom p {
    margin: 0;
    color: inherit;
  }
</style>
