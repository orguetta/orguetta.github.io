---
export interface Props {
  frontmatter: {
    title?: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? "Resume";
const description = frontmatter?.description ?? "Resume PDF view";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="stylesheet" href="/resume-pdf.css" />
  </head>
  <body>
    <slot />
  </body>
</html>
