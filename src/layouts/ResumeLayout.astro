---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";
import IconMail from "@/assets/icons/IconMail.svg";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconLinkedin from "@/assets/icons/IconLinkedin.svg";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
    contact?: {
      email: string;
      github: string;
      linkedin: string;
      phone?: string;
    };
    skills?: Array<{
      category: string;
      items: string[];
    }>;
    education?: Array<{
      title: string;
      date: string;
      org?: string;
    }>;
    languages?: Array<{
      name: string;
      level: string;
    }>;
  };
}

const { frontmatter } = Astro.props;
---

<Layout
  title={`${frontmatter.title} | ${SITE.title}`}
  description={frontmatter.description}
>
  <Header />
  <main id="main-content" class="mx-auto px-4">
    <div class="resume-container mx-auto mt-12 mb-24 max-w-app">
      <div class="resume-grid">
        <!-- Main Column -->
        <article class="resume-main">
          <section class="app-prose">
            <slot />
          </section>
        </article>

        <!-- Sidebar -->
        <aside class="resume-sidebar">
          {
            frontmatter.contact && (
              <section class="sidebar-section">
                <h3>Contact</h3>
                <ul class="contact-list">
                  <li>
                    <a href={`mailto:${frontmatter.contact.email}`}>
                      <IconMail class="icon" />
                      <span>{frontmatter.contact.email}</span>
                    </a>
                  </li>
                  <li>
                    <a
                      href={`https://github.com/${frontmatter.contact.github}`}
                      target="_blank"
                    >
                      <IconGitHub class="icon" />
                      <span>github.com/{frontmatter.contact.github}</span>
                    </a>
                  </li>
                  <li>
                    <a
                      href={`https://linkedin.com/in/${frontmatter.contact.linkedin}`}
                      target="_blank"
                    >
                      <IconLinkedin class="icon" />
                      <span>
                        linkedin.com/in/{frontmatter.contact.linkedin}
                      </span>
                    </a>
                  </li>
                  {frontmatter.contact.phone && (
                    <li>
                      <a href={`tel:${frontmatter.contact.phone}`}>
                        <span class="icon phone-icon">📱</span>
                        <span>{frontmatter.contact.phone}</span>
                      </a>
                    </li>
                  )}
                </ul>
                <a href="/resume.pdf" class="download-btn">
                  Download PDF
                </a>
              </section>
            )
          }

          {
            frontmatter.skills && (
              <section class="sidebar-section">
                <h3>Skills</h3>
                <div class="skills-grid">
                  {frontmatter.skills.map(group => (
                    <div class="skill-group">
                      <h4>{group.category}</h4>
                      <div class="skill-chips">
                        {group.items.map(skill => (
                          <span class="skill-chip">{skill}</span>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            )
          }

          {
            frontmatter.education && (
              <section class="sidebar-section">
                <h3>Education</h3>
                <ul class="education-list">
                  {frontmatter.education.map(edu => (
                    <li>
                      <div class="edu-title">{edu.title}</div>
                      <div class="edu-meta">
                        {edu.date} {edu.org && `· ${edu.org}`}
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            frontmatter.languages && (
              <section class="sidebar-section">
                <h3>Languages</h3>
                <ul class="language-list">
                  {frontmatter.languages.map(
                    lang =>
                      lang.name &&
                      lang.level && (
                        <li>
                          <strong>{lang.name}:</strong> {lang.level}
                        </li>
                      )
                  )}
                </ul>
              </section>
            )
          }
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .resume-container {
    /* max-w-app handled via class attribute */
  }

  .resume-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media (min-width: 1024px) {
    .resume-grid {
      grid-template-columns: 1fr 320px;
    }
  }

  /* Main Content Styling */
  .resume-main :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 0.5rem;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .resume-main :global(h2:first-of-type) {
    margin-top: 0;
  }

  .resume-main :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--accent);
  }

  .resume-main :global(h3 + p) {
    font-style: italic;
    color: var(--foreground);
    opacity: 0.8;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .resume-main :global(h4) {
    font-size: 1rem;
    font-weight: 500;
    margin-top: -0.4rem;
    margin-bottom: 1rem;
    color: var(--foreground);
    opacity: 0.8;
  }

  .resume-main :global(ul) {
    list-style-type: disc;
    margin-left: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .resume-main :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  /* Sidebar Styling */
  .resume-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .sidebar-section h3 {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--primary);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--accent);
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-list li a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--foreground);
    opacity: 0.85;
    transition: all 0.2s;
  }

  .contact-list li a:hover {
    opacity: 1;
    color: var(--accent);
  }

  .icon {
    width: 1.1rem;
    height: 1.1rem;
    stroke: currentColor;
    stroke-width: 2;
  }

  .phone-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    line-height: 1;
  }

  .download-btn {
    display: inline-block;
    margin-top: 1.5rem;
    width: 100%;
    text-align: center;
    padding: 0.75rem;
    background-color: var(--accent);
    color: #FAFAF0;
    border-radius: 0.5rem;
    font-weight: 700;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: filter 0.2s;
  }

  .download-btn:hover {
    filter: brightness(1.1);
  }

  .skill-group {
    margin-bottom: 1.25rem;
  }

  .skill-group h4 {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--foreground);
    opacity: 0.7;
    margin-bottom: 0.5rem;
  }

  .skill-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .skill-chip {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    background-color: var(--muted);
    color: var(--foreground);
    padding: 0.25rem 0.6rem;
    border-radius: 0.35rem;
    border: 1px solid var(--border);
    white-space: nowrap;
    transition: all 0.2s;
    font-weight: 500;
  }

  .skill-chip:hover {
    border-color: var(--accent);
    background-color: var(--accent);
    color: #FAFAF0;
  }

  .education-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .edu-title {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .edu-meta {
    font-size: 0.85rem;
    opacity: 0.7;
    margin-top: 0.15rem;
  }

  .language-list {
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Print Styles */
  @media print {
    :global(header),
    :global(footer),
    .download-btn {
      display: none !important;
    }

    .resume-grid {
      display: grid;
      grid-template-columns: 1fr 240px;
      gap: 2rem;
    }

    body {
      background-color: white !important;
      color: black !important;
    }

    .skill-chip {
      background-color: #f0f0f0 !important;
      border: 1px solid #ddd;
    }

    #main-content {
      max-width: 100% !important;
      padding: 0 !important;
    }
  }
</style>
