---
import type { CollectionEntry } from "astro:content";
import IconEdit from "@/assets/icons/IconEdit.svg";
import { SITE } from "@/config";

export interface Props {
  hideEditPost?: CollectionEntry<"blog">["data"]["hideEditPost"];
  class?: string;
  post: CollectionEntry<"blog">;
}

const { hideEditPost, post, class: className = "" } = Astro.props;

const editBase = SITE.editPost.url.endsWith("/")
  ? SITE.editPost.url
  : `${SITE.editPost.url}/`;
const normalizedPath = (post.filePath ?? "").replace(/^\.?\/+/, "");
const href = new URL(normalizedPath, editBase).toString();
const showEditPost =
  SITE.editPost.enabled && !hideEditPost && normalizedPath !== "";
---

{
  showEditPost && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        "flex justify-baseline gap-1.5 opacity-80 hover:text-accent",
        className,
      ]}
    >
      <IconEdit class="inline-block" />
      <span>{SITE.editPost.text}</span>
    </a>
  )
}
