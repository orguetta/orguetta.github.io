---
export interface Props {
  title: string;
  subtitle?: string;
  level?: "h1" | "h2" | "h3";
  class?: string;
}

const { title, subtitle, level = "h2", class: className = "" } = Astro.props;
const HeadingTag = level;
---

<header class:list={["mb-4 flex items-end justify-between gap-3", className]}>
  <div class="space-y-1">
    <HeadingTag
      class:list={[
        "font-[var(--font-heading)] text-primary",
        level === "h1" && "text-4xl leading-tight font-bold sm:text-5xl",
        level === "h2" && "text-2xl font-semibold tracking-wide",
        level === "h3" && "text-xl font-semibold",
      ]}
    >
      {title}
    </HeadingTag>
    {subtitle && <p class="text-text-2">{subtitle}</p>}
  </div>
  <slot name="action" />
</header>
