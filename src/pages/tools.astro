---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Hr from "@/components/Hr.astro";
---

<Layout title="Tools | Or Guetta">
  <Header />
  <main id="main-content">
    <section id="tools" class="pt-8 pb-6">
      <h1 class="text-3xl font-bold sm:text-4xl">Technical Tools</h1>
      <p class="mt-4">
        A collection of scripts, calculators, and utilities for cybersecurity and infrastructure engineering.
      </p>

      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <div class="rounded-lg border border-border p-6 transition-colors hover:border-accent">
          <h2 class="text-xl font-bold">
            <a href="/PermCalc/" target="_blank" class="hover:text-accent">
              Permission Calculator
            </a>
          </h2>
          <p class="mt-2 text-sm opacity-80">
            A tool for calculating and visualizing file permissions and access control lists.
          </p>
        </div>

        <div class="rounded-lg border border-border p-6 transition-colors hover:border-accent">
          <h2 class="text-xl font-bold">
            <a href="/IPSubCalc/" target="_blank" class="hover:text-accent">
              IP Subnet Calculator
            </a>
          </h2>
          <p class="mt-2 text-sm opacity-80">
            CIDR subnet calculator for network planning and infrastructure design.
          </p>
        </div>
      </div>
    </section>
    <Hr />
  </main>
  <Footer />
</Layout>
