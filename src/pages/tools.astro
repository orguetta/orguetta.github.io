---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Hr from "@/components/Hr.astro";
import Card from "@/components/Card.astro";
import SectionHeader from "@/components/SectionHeader.astro";
---

<Layout title="Tools | Or Guetta">
  <Header />
  <main id="main-content">
    <section id="tools" class="ui-prose pt-8 pb-6">
      <SectionHeader
        level="h1"
        title="Technical Tools"
        subtitle="Scripts and calculators for cybersecurity and infrastructure operations."
      />

      <ul class="mt-8 grid gap-6 sm:grid-cols-2">
        <Card
          variant="tool"
          href="/PermCalc/"
          title="Permission Calculator"
          description="Calculate and visualize Unix file permissions and access control logic."
          external
        />
        <Card
          variant="tool"
          href="/IPSubCalc/"
          title="IP Subnet Calculator"
          description="CIDR subnet calculation for network planning and infrastructure design."
          external
        />
      </ul>
    </section>
    <Hr />
  </main>
  <Footer />
</Layout>
