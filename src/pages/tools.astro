---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Hr from "@/components/Hr.astro";
import Main from "@/layouts/Main.astro";
import Card from "@/components/Card.astro";
import SectionHeader from "@/components/SectionHeader.astro";
---

<Layout title="Tools | Or Guetta">
  <Header />
  <Main
    pageTitle="Technical Tools"
    pageDesc="Scripts and calculators for cybersecurity and infrastructure operations."
  >
    <section id="tools" class="ui-prose pb-2">
      <SectionHeader
        level="h2"
        title="Available Tools"
        subtitle="Built for practical daily operations and quick validation workflows."
      />

      <ul class="mt-6 grid gap-6 sm:grid-cols-2">
        <Card
          variant="tool"
          href="/PermCalc/"
          title="Permission Calculator"
          description="Calculate and visualize Unix file permissions and access control logic."
          external
        />
        <Card
          variant="tool"
          href="/IPSubCalc/"
          title="IP Subnet Calculator"
          description="CIDR subnet calculation for network planning and infrastructure design."
          external
        />
      </ul>
    </section>
    <Hr />
  </Main>
  <Footer />
</Layout>
