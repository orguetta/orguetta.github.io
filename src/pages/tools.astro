---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Hr from "@/components/Hr.astro";
import Main from "@/layouts/Main.astro";
import Card from "@/components/Card.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { getGitHubRepositories } from "@/utils/getGitHubRepositories";

const publicRepositories = await getGitHubRepositories();
---

<Layout title="Tools | Or Guetta">
  <Header />
  <Main
    pageTitle="Technical Tools"
    pageDesc="Scripts and calculators for cybersecurity and infrastructure operations."
  >
    <section id="github-repos" class="ui-prose pb-2">
      <SectionHeader
        level="h2"
        title="Public GitHub Repositories"
        subtitle="Automatically synced from GitHub so this page stays current without manual updates."
      />

      {
        publicRepositories.length > 0 ? (
          <ul class="mt-6 grid gap-6 sm:grid-cols-2">
            {publicRepositories.map(repository => (
              <Card
                variant="tool"
                href={repository.homepage ?? repository.htmlUrl}
                title={repository.name}
                description={repository.description}
                external
              />
            ))}
          </ul>
        ) : (
          <p class="mt-6 text-text-2">
            GitHub repositories could not be loaded right now. Please try again
            later.
          </p>
        )
      }
    </section>
    <Hr />
  </Main>
  <Footer />
</Layout>
