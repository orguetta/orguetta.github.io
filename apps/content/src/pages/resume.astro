---
import "@/styles/global.css";

/**
 * Resume has moved to the primary domain.
 * Static meta-refresh keeps legacy /resume links working on GitHub Pages.
 */
const target = "https://guetta.tech/resume";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Resume moved — Or Guetta</title>
  </head>
  <body>
    <p>
      The resume lives on the primary site now.
      <a href={target}>Continue to guetta.tech/resume</a>.
    </p>
  </body>
</html>
