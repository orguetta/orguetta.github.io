---
// The header is shared by every guetta.tech site; see
// packages/design-system/src/components/SiteHeader.astro.
// The writing hub only adds a search link.
import SiteHeader from "@guetta/design-system/components/SiteHeader.astro";
import IconSearch from "@/assets/icons/IconSearch.svg";

const isSearch = Astro.url.pathname.startsWith("/search");
---

<SiteHeader>
  <a
    slot="actions"
    href="/search"
    class="g-icon-button"
    aria-label="Search"
    title="Search"
    aria-current={isSearch ? "page" : undefined}
  >
    <IconSearch width={16} height={16} aria-hidden="true" />
  </a>
</SiteHeader>
