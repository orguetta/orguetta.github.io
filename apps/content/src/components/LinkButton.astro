---
export interface Props {
  id?: string;
  href: string;
  class?: string;
  ariaLabel?: string;
  title?: string;
  disabled?: boolean;
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md";
}

const {
  id,
  href,
  class: className = "",
  ariaLabel,
  title,
  disabled = false,
  variant = "ghost",
  size = "md",
} = Astro.props;

const baseClass =
  "group inline-flex items-center justify-center gap-2 rounded-md border border-transparent transition-colors duration-[var(--duration-fast)]";
const sizeClass =
  size === "sm" ? "px-3 py-1.5 text-sm font-medium" : "px-4 py-2 font-medium";
const variantClass = {
  primary:
    "bg-text-1 text-surface-1 hover:opacity-80",
  secondary:
    "border-border bg-surface-3 text-foreground hover:border-text-3",
  ghost: "text-text-2 hover:text-text-1",
}[variant];
---

{
  disabled ? (
    <span
      id={id}
      class:list={[
        baseClass,
        sizeClass,
        variantClass,
        "cursor-not-allowed opacity-50",
        className,
      ]}
      title={title}
      aria-disabled={disabled}
    >
      <slot />
    </span>
  ) : (
    <a
      id={id}
      {href}
      class:list={[baseClass, sizeClass, variantClass, className]}
      aria-label={ariaLabel}
      title={title}
    >
      <slot />
    </a>
  )
}
