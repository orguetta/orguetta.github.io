---
import { slugifyStr } from "@/utils/slugify";
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type LegacyVariant = "h2" | "h3";
type Variant = "post" | "tool" | "compact" | LegacyVariant;

interface BaseProps {
  variant?: Variant;
}

interface PostCardProps extends BaseProps, CollectionEntry<"blog"> {
  href?: never;
  title?: never;
  description?: never;
  external?: never;
}

interface ToolCardProps extends BaseProps {
  href: string;
  title: string;
  description: string;
  external?: boolean;
  id?: never;
  filePath?: never;
  data?: never;
}

export type Props = PostCardProps | ToolCardProps;

const props = Astro.props as Props;
const variant = props.variant ?? ("data" in props ? "post" : "tool");
const isPostCard = "data" in props;

const cardWrapperClass = {
  post: "my-6 border-b border-border/70 pb-5",
  h2: "my-6 border-b border-border/70 pb-5",
  h3: "my-6 border-b border-border/70 pb-5",
  compact: "my-3 border-b border-border/50 pb-3",
  tool: "ui-surface ui-hover-lift my-0 p-6",
}[variant];

const titleClass = variant === "compact" ? "text-base" : "text-xl";

const headingTag = variant === "h2" ? "h2" : "h3";

const anchorClass = {
  post: "inline-flex items-start text-text-1 underline-offset-4 hover:opacity-60",
  h2: "inline-flex items-start text-text-1 underline-offset-4 hover:opacity-60",
  h3: "inline-flex items-start text-text-1 underline-offset-4 hover:opacity-60",
  compact:
    "inline-flex items-start text-text-1/95 underline-offset-4 hover:opacity-60",
  tool: "inline-flex items-start text-text-1 underline-offset-4 hover:opacity-60",
}[variant];
---

{
  isPostCard ? (
    <li class={cardWrapperClass}>
      {(() => {
        const post = props as PostCardProps;
        const { title, description, pubDatetime, modDatetime, timezone } =
          post.data;
        const href = getPath(post.id, post.filePath);
        const headingProps = {
          style: { viewTransitionName: slugifyStr(title) },
        };

        return (
          <>
            {headingTag === "h2" ? (
              <h2 {...headingProps} class={titleClass}>
                <a href={href} class={anchorClass}>
                  {title}
                </a>
              </h2>
            ) : (
              <h3 {...headingProps} class={titleClass}>
                <a href={href} class={anchorClass}>
                  {title}
                </a>
              </h3>
            )}
            <Datetime {pubDatetime} {modDatetime} {timezone} />
            <p class="mt-2 text-text-2">{description}</p>
          </>
        );
      })()}
    </li>
  ) : (
    <li class={cardWrapperClass}>
      {(() => {
        const tool = props as ToolCardProps;
        return (
          <>
            <h3 class={titleClass}>
              <a
                href={tool.href}
                class={anchorClass}
                target={tool.external ? "_blank" : undefined}
                rel={tool.external ? "noopener noreferrer" : undefined}
              >
                {tool.title}
              </a>
            </h3>
            <p class="mt-2 text-sm text-text-2">{tool.description}</p>
          </>
        );
      })()}
    </li>
  )
}
