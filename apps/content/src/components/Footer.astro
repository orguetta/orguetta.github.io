---
// The footer is shared by every guetta.tech site; see
// packages/design-system/src/components/SiteFooter.astro.
import SiteFooter from "@guetta/design-system/components/SiteFooter.astro";

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<div class:list={["footer-wrap", { "mt-auto": !noMarginTop }]}>
  <SiteFooter>
    <a href="/rss.xml">RSS</a>
  </SiteFooter>
</div>

<style>
  .footer-wrap {
    width: 100%;
  }
</style>
