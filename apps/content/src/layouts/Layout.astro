---
import "@guetta/design-system/tokens.css";
import "@guetta/design-system/fonts.css";
import "@/styles/global.css";
// After global.css: base.css shares Tailwind's base layer and must come
// after Preflight to override it, while utilities still win.
import "@guetta/design-system/base.css";
import ThemeHead from "@guetta/design-system/components/ThemeHead.astro";
import { SITE } from "@/config";

export interface Props {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
}

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
} = Astro.props;

const socialImageURL = new URL(
  ogImage ?? SITE.ogImage ?? "og.png",
  Astro.url.origin
).href;

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

const person = {
  "@type": "Person",
  name: author,
  ...(profile && { url: profile }),
  sameAs: [
    profile,
    "https://github.com/orguetta",
    "https://linkedin.com/in/orguetta",
  ],
};

const structuredData = pubDatetime
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      url: canonicalURL,
      image: socialImageURL,
      datePublished: pubDatetime.toISOString(),
      ...(modDatetime && { dateModified: modDatetime.toISOString() }),
      author: [person],
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: title,
      description,
      url: canonicalURL,
      image: socialImageURL,
      author: person,
    };
---

<!doctype html>
<html
  dir={SITE.dir}
  lang=`${SITE.lang ?? "en"}`
  class:list={{ "scroll-smooth": scrollSmooth }}
  transition:animate="fade"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:type" content={pubDatetime ? "article" : "website"} />

    <!-- Article Published/Modified time -->
    {pubDatetime && (
      <meta
        property="article:published_time"
        content={pubDatetime.toISOString()}
      />
    )}
    {modDatetime && (
      <meta
        property="article:modified_time"
        content={modDatetime.toISOString()}
      />
    )}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    ></script>
    <!-- Enable RSS feed auto-discovery  -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}

    <ThemeHead />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /*
   * Fonts, colours, heading weight and link behaviour come from
   * @guetta/design-system (tokens.css, fonts.css, base.css).
   * Heading sizes match apps/landing so both sites share one scale.
   */

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    margin: 0;
  }

  h1 {
    font-size: clamp(3rem, 6vw, 4.5rem);
    margin-bottom: var(--space-md);
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: var(--space-sm);
  }

  h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-xs);
  }
</style>
