{
  "name": "landing",
  "description": "Personal website built with Astro Framework and Cloudflare Workers",
  "author": "Or Guetta",
  "version": "0.0.2",
  "license": "MIT",
  "cloudflare": {
    "label": "Astro Framework Starter",
    "products": [
      "Workers"
    ],
    "categories": [],
    "preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/394ca3c9-d351-4036-035a-9f6dfa26dd00/public",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/f40a6577-eed5-4f3e-cef4-b5ef0a1be100/preview",
    "publish": true
  },
  "dependencies": {
    "@guetta/design-system": "workspace:*",
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@yeskunall/astro-umami": "^0.0.9",
    "astro": "^7.1.3",
    "geist": "^1.7.2",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "eslint": "10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "puppeteer": "^25.8.0",
    "typescript-eslint": "^8.65.0",
    "wrangler": "^4.114.0"
  },
  "private": true,
  "scripts": {
    "astro": "astro",
    "build": "bash scripts/generate-pdf.sh && astro build",
    "cf-typegen": "wrangler types",
    "check": "astro build && tsc && wrangler deploy --config dist/server/wrangler.json --dry-run",
    "deploy": "bash scripts/generate-pdf.sh && astro build && wrangler deploy --config dist/server/wrangler.json",
    "dev": "astro dev",
    "preview": "astro build && wrangler dev --config dist/server/wrangler.json",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "resume:pdf": "chmod +x scripts/generate-pdf.sh && ./scripts/generate-pdf.sh"
  },
  "type": "module"
}
