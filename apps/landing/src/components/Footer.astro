<style>
	footer {
		padding: 3rem 0;
		text-align: center;
		margin-top: auto;
		border-top: 1px solid var(--border);
	}
	.footer-top {
		margin-bottom: 1.5rem;
	}
	.footer-links {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	.footer-links a {
		padding: 0.5rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		color: var(--text-2);
		font-size: 0.875rem;
		transition:
			border-color var(--duration-fast) ease,
			color var(--duration-fast) ease;
	}
	.footer-links a:hover {
		border-color: var(--text-3);
		color: var(--text-1);
		text-decoration: none;
		opacity: 1;
	}
	.footer-socials {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		justify-content: center;
		margin-bottom: 1.5rem;
	}
	.social-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		color: var(--text-3);
		text-decoration: none;
		transition:
			border-color var(--duration-fast) ease,
			color var(--duration-fast) ease;
	}
	.social-btn:hover {
		border-color: var(--text-3);
		color: var(--text-1);
		opacity: 1;
		text-decoration: none;
	}
	.footer-bottom {
		padding-top: 1rem;
		border-top: 1px solid var(--border);
	}
	.footer-bottom p {
		margin-bottom: 0;
	}
</style>
