---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from "../consts";
import { BRAND, DOMAINS, NAV, SOCIALS } from "@guetta/design-system/navigation";

const experience = [
  {
    period: "2022 — Present",
    role: "Senior Network & Cybersecurity Engineer",
    org: "Integrity Software",
    summary:
      "Secure web access and identity for enterprise and government clients: NetScaler Gateway, SSO, MFA and load balancing, from design through customer training.",
    tags: ["NetScaler", "SSO", "MFA", "Load Balancing"],
  },
  {
    period: "2021 — 2022",
    role: "CyberArk & PKI Specialist",
    org: "Securenet Solutions",
    summary:
      "CyberArk PAS integration for regulated organisations, PKI stacks on Microsoft ADCS and EJBCA, and OS and server hardening.",
    tags: ["CyberArk PAS", "PKI", "ADCS", "EJBCA"],
  },
  {
    period: "2019 — 2020",
    role: "System & Security Admin",
    org: "Altshuler Shaham",
    summary:
      "Managed over 600 virtual servers on VMware. Built PKI, MDM and IAM platforms from the ground up and automated operations with PowerShell.",
    tags: ["VMware", "PKI", "MDM", "PowerShell"],
  },
  {
    period: "2018 — 2019",
    role: "System Administrator",
    org: "EDP Group Israel",
    summary:
      "Infrastructure and firewall support for SMB clients: terminal servers, VPN access, FortiGate firewalls and tier 2 escalations.",
    tags: ["FortiGate", "VPN", "Terminal Servers"],
  },
  {
    period: "2015 — 2018",
    role: "Military IT & Network Security Specialist",
    org: "Israeli Air Force",
    summary:
      "Secure communications and IT operations in classified environments. Defined and enforced security policy for mission-critical systems.",
    tags: ["Network Security", "Monitoring"],
  },
];

// Published posts only (draft: false in apps/content). Slugs match the built
// routes under /posts; re-check them when a post is renamed.
const writing = [
  {
    title:
      "NetScaler Security Best Practices: WAF, Rate Limiting, and Hardening",
    href: `${NAV.posts}/netscaler-security-best-practices`,
  },
  {
    title: "NetScaler ADC Hardening Best Practices Guide",
    href: `${NAV.posts}/NetScaler-ADC-Hardening-Best-Practices-Guide`,
  },
  {
    title: "Protecting AAA and NetScaler Gateway with WAF",
    href: `${NAV.posts}/2024-06-30-protecting-aaa-and-netscaler-gateway-with-waf`,
  },
  {
    title: "NetScaler KCD Configuration Guide (Kerberos SSO Step by Step)",
    href: `${NAV.posts}/netscaler-kcd-configuration-guide`,
  },
  {
    title: "Configuring SMS OTP for Web Authentication on NetScaler",
    href: `${NAV.posts}/configuring-sms-otp-for-web-authentication-on-netscaler`,
  },
  {
    title: "Automating NetScaler Management with APIs and Scripting",
    href: `${NAV.posts}/automating-netscaler-management-with-apis-and-scripting`,
  },
];

// Credentials follow resume.md and the LinkedIn profile.
const certifications = [
  "Citrix Certified Associate – App Delivery and Security (CCA-AppDS)",
  "CyberArk PAM Install and Configure (self-paced)",
  "CyberArk PAM Administration for Partners (self-paced)",
];

const education = [
  {
    title: "DevSecOps Engineer",
    org: "Bar-Ilan University",
    period: "2023 — 2024",
  },
  {
    title:
      "Industrial Engineering, Information Systems Engineering & Management",
    org: "The Open University of Israel",
    period: "2021 — Present",
  },
];

const languages = [
  "Hebrew (native or bilingual)",
  "English (full professional)",
];

const sections = [
  { id: "intro", label: "Intro" },
  { id: "experience", label: "Experience" },
  { id: "credentials", label: "Credentials" },
  { id: "writing", label: "Writing" },
  { id: "contact", label: "Contact" },
];

const focus = [
  "NetScaler",
  "WAF",
  "Identity & SSO",
  "PKI",
  "CyberArk PAM",
  "DevSecOps",
  "Cloud Security",
  "Terraform & Ansible",
];

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: BRAND.name,
  url: SITE_URL,
  jobTitle: "Senior Network & Cybersecurity Engineer",
  description: SITE_DESCRIPTION,
  email: `mailto:${BRAND.email}`,
  knowsAbout: [
    "NetScaler",
    "Application delivery controllers",
    "Web application firewalls",
    "Single sign-on",
    "PKI",
    "Identity and access management",
    "Cloud security",
  ],
  sameAs: [...SOCIALS.map(s => s.href), DOMAINS.content, NAV.resume],
  worksFor: { "@type": "Organization", name: "Integrity Software" },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Bar-Ilan University" },
    { "@type": "CollegeOrUniversity", name: "The Open University of Israel" },
  ],
  hasCredential: certifications.map(name => ({
    "@type": "EducationalOccupationalCredential",
    name,
  })),
  knowsLanguage: ["he", "en"],
};
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(personJsonLd)}
  ></script>
  <nav class="side-nav" aria-label="Section navigation">
    <div class="side-nav-dots">
      {sections.map(section => (
        <button
          type="button"
          data-section={section.id}
          class="nav-dot"
          aria-label={`Go to ${section.label}`}
        />
      ))}
    </div>
  </nav>

  <section
    id="intro"
    class="hero scroll-section reveal"
    aria-labelledby="hero-title"
  >
    <p class="g-label">Security engineer · Israel</p>
    <h1 id="hero-title">Or Guetta</h1>
    <p class="lead">
      I build and harden secure access: NetScaler, single sign-on, PKI and the
      cloud controls around them. I write up what works in production.
    </p>

    <div class="status">
      <span class="dot" aria-hidden="true"></span>
      Open to security engineering, DevSecOps and consulting roles
    </div>

    <div class="actions">
      <a class="g-button" href={NAV.posts}>
        Read the writing
      </a>
      <a class="g-button g-button--quiet" href={NAV.resume}>
        Resume
      </a>
      <a class="g-button g-button--quiet" href={NAV.tools}>
        Tools
      </a>
    </div>

    <dl class="facts">
      <div>
        <dt>Now</dt>
        <dd>
          Senior Network &amp; Cybersecurity Engineer at Integrity Software
        </dd>
      </div>
      <div>
        <dt>Focus</dt>
        <dd>
          <ul class="tags" aria-label="Focus areas">
            {focus.map(item => (
              <li class="g-tag">{item}</li>
            ))}
          </ul>
        </dd>
      </div>
    </dl>
  </section>

  <section
    id="experience"
    class="block scroll-section reveal"
    aria-labelledby="experience-title"
  >
    <header class="block-head">
      <h2 id="experience-title">Experience</h2>
      <p class="g-label">2015 — Present</p>
    </header>

    <ol class="rows">
      {experience.map(item => (
        <li class="row">
          <p class="row-period">{item.period}</p>
          <div class="row-main">
            <h3>{item.role}</h3>
            <p class="row-org">{item.org}</p>
            <p class="row-summary">{item.summary}</p>
            <ul class="tags">
              {item.tags.map(t => (
                <li class="g-tag">{t}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section
    id="credentials"
    class="block scroll-section reveal"
    aria-labelledby="credentials-title"
  >
    <header class="block-head">
      <h2 id="credentials-title">Credentials</h2>
    </header>

    <div class="creds">
      <div>
        <h3 class="g-label">Certifications</h3>
        <ul class="plain">
          {certifications.map(item => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="g-label">Education</h3>
        <ul class="plain">
          {education.map(item => (
            <li>
              <span class="cred-title">{item.title}</span>
              <span class="cred-meta">
                {item.org} · {item.period}
              </span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="g-label">Languages</h3>
        <ul class="plain">
          {languages.map(item => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section
    id="writing"
    class="block scroll-section reveal"
    aria-labelledby="writing-title"
  >
    <header class="block-head">
      <h2 id="writing-title">Writing</h2>
      <a class="g-label link" href={NAV.posts}>
        All posts
      </a>
    </header>

    <ul class="rows">
      {writing.map(post => (
        <li>
          <a class="post-row" href={post.href}>
            <span>{post.title}</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section
    id="contact"
    class="block scroll-section reveal"
    aria-labelledby="contact-title"
  >
    <header class="block-head">
      <h2 id="contact-title">Contact</h2>
    </header>

    <p class="lead">
      Happy to talk about secure access, NetScaler, identity, or how to make a
      system defensible without slowing the team down.
    </p>

    <p class="email">
      <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>
    </p>

    <ul class="links" aria-label="Elsewhere">
      {SOCIALS.map(link => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <script is:inline>
    (function () {
      document.documentElement.classList.add("js");

      const sections = document.querySelectorAll(".scroll-section");
      const dots = document.querySelectorAll(".nav-dot");

      const observer = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            dots.forEach(dot => {
              dot.classList.toggle(
                "active",
                dot.dataset.section === entry.target.id
              );
            });
          });
        },
        { threshold: 0.25, rootMargin: "0px 0px -15% 0px" }
      );

      sections.forEach(section => observer.observe(section));

      dots.forEach(dot => {
        dot.addEventListener("click", () => {
          const target = document.getElementById(dot.dataset.section);
          if (target) target.scrollIntoView({ behavior: "smooth" });
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  /* Side navigation: fixed dots that follow the section in view */
  .side-nav {
    position: fixed;
    left: 2rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
  }

  .side-nav-dots {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .nav-dot {
    width: 0.5rem;
    height: 2rem;
    border-radius: 999px;
    border: none;
    background: var(--text-3);
    opacity: 0.3;
    cursor: pointer;
    padding: 0;
    transition:
      opacity var(--duration-base) ease,
      background var(--duration-base) ease;
  }

  .nav-dot:hover {
    opacity: 0.6;
  }

  .nav-dot.active {
    background: var(--signal);
    opacity: 1;
  }

  @media (max-width: 1023px) {
    .side-nav {
      display: none;
    }
  }

  /* Sections fill the viewport and rise into place as they enter */
  .scroll-section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .js .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity var(--duration-base) ease,
      transform var(--duration-base) ease;
  }

  .js .reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  .hero {
    padding: clamp(3rem, 10vh, 6rem) 0 var(--space-7);
  }

  .g-label {
    margin: 0;
  }

  h1 {
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin: var(--space-3) 0 var(--space-5);
  }

  .lead {
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--text-2);
    max-width: 38rem;
    margin: 0 0 var(--space-5);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    color: var(--text-2);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--signal);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-5) 0 var(--space-6);
  }

  .facts {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  @media (min-width: 40rem) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: var(--space-2);
  }

  .facts dd {
    margin: 0;
    color: var(--text-1);
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: var(--space-3) 0 0;
  }

  .g-tag {
    margin: 0;
  }

  .block {
    padding: var(--space-7) 0;
    border-top: 1px solid var(--border);
  }

  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .link {
    color: var(--text-2);
  }

  .creds {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .creds {
      grid-template-columns: 1.4fr 1.4fr 1fr;
    }
  }

  .creds h3 {
    margin: 0 0 var(--space-3);
  }

  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    font-size: 0.9375rem;
    color: var(--text-1);
  }

  .plain li {
    margin: 0;
  }

  .cred-title {
    display: block;
  }

  .cred-meta {
    display: block;
    color: var(--text-3);
    font-size: 0.875rem;
  }

  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .row {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border);
  }

  .row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 9rem 1fr;
      gap: var(--space-5);
    }
  }

  .row-period {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-3);
    margin: 0;
  }

  .row h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-1);
  }

  .row-org {
    margin: 0.15rem 0 var(--space-2);
    color: var(--text-2);
    font-size: 0.9375rem;
  }

  .row-summary {
    margin: 0;
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .post-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border);
    color: var(--text-1);
    font-weight: 500;
  }

  .post-row:hover {
    opacity: 1;
    color: var(--signal);
  }

  .post-row .arrow {
    color: var(--text-3);
    transition: transform var(--duration-fast) ease;
  }

  .post-row:hover .arrow {
    transform: translateX(3px);
    color: var(--signal);
  }

  .email {
    font-size: 1.25rem;
    margin: var(--space-4) 0 var(--space-5);
  }

  .email a {
    color: var(--text-1);
    border-bottom: 1px solid var(--signal);
  }

  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    margin: 0;
  }

  .links a {
    color: var(--text-2);
  }

  .links a:hover {
    color: var(--signal);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .js .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
