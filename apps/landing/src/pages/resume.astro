---
import BaseLayout from "../layouts/BaseLayout.astro";

const files = import.meta.glob("../content/resume.md", {
  query: "?raw",
  eager: true,
});
const rawMd = (files["../content/resume.md"] as { default: string }).default;

function mdToHtml(md: string): string {
  let html = md;

  // Remove frontmatter
  html = html.replace(/^---[\s\S]*?---\n*/, "");

  // Headers (order: longest prefix first)
  html = html.replace(/^######\s+(.+)$/gm, "<h6>$1</h6>");
  html = html.replace(/^#####\s+(.+)$/gm, "<h5>$1</h5>");
  html = html.replace(/^####\s+(.+)$/gm, "<h4>$1</h4>");
  html = html.replace(/^###\s+(.+)$/gm, "<h3>$1</h3>");
  html = html.replace(/^##\s+(.+)$/gm, "<h2>$1</h2>");
  html = html.replace(/^#\s+(.+)$/gm, "<h1>$1</h1>");

  // Bold + italic
  html = html.replace(/\*\*\*(.+?)\*\*\*/g, "<strong><em>$1</em></strong>");
  html = html.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
  html = html.replace(/\*(.+?)\*/g, "<em>$1</em>");

  // Inline code
  html = html.replace(/`([^`]+)`/g, "<code>$1</code>");

  // Links
  html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');

  // Horizontal rule
  html = html.replace(/^---+$/gm, "<hr />");

  // Definition list items (key:value pattern used in resume.md)
  html = html.replace(/^:\s+(.+)$/gm, "<dd>$1</dd>");

  // Unordered lists
  html = html.replace(/^- (.+)$/gm, "<li>$1</li>");
  html = html.replace(/((?:<li>.*<\/li>\n?)+)/g, "<ul>$1</ul>");

  // Paragraphs — wrap remaining loose text in <p>
  const lines = html.split("\n");
  const result: string[] = [];

  for (const line of lines) {
    const trimmed = line.trim();
    if (
      trimmed.startsWith("<h") ||
      trimmed.startsWith("<ul") ||
      trimmed.startsWith("</ul") ||
      trimmed.startsWith("<li") ||
      trimmed.startsWith("<hr") ||
      trimmed.startsWith("<dd") ||
      trimmed.startsWith("<dl") ||
      trimmed.startsWith("</dl") ||
      trimmed.startsWith("<a") ||
      trimmed.startsWith("<div") ||
      trimmed.startsWith("</div") ||
      trimmed.startsWith("<p") ||
      trimmed.startsWith("</p") ||
      trimmed.startsWith("<strong") ||
      trimmed === ""
    ) {
      result.push(line);
    } else {
      result.push(`<p>${trimmed}</p>`);
    }
  }

  return result.join("\n");
}

const resumeHtml = mdToHtml(rawMd);
---

<BaseLayout
  title="Resume — Or Guetta"
  description="Resume and professional experience of Or Guetta"
>
  <section class="resume-page">
    <div class="resume-toolbar">
      <a href="/" class="back-link">
        <svg
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          width="16"
          height="16"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        Back
      </a>
      <a href="/resume.pdf" download class="btn-secondary download-btn">
        <svg
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          width="16"
          height="16"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
          ></path>
        </svg>
        Download PDF
      </a>
    </div>

    <div class="resume-content" set:html={resumeHtml} />
  </section>
</BaseLayout>

<style>
  .resume-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .resume-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-3);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .back-link:hover {
    color: var(--text-1);
    opacity: 1;
    text-decoration: none;
  }

  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }

  /* Resume content styles */
  .resume-content :global(h1) {
    font-size: 2rem;
    font-weight: 300;
    text-align: center;
    margin-bottom: 0.75rem;
  }

  .resume-content :global(h2) {
    font-size: 1.25rem;
    font-weight: 500;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .resume-content :global(h3) {
    font-size: 1rem;
    font-weight: 500;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .resume-content :global(p) {
    margin: 0.25rem 0 0.75rem 0;
    color: var(--text-2);
    line-height: 1.6;
  }

  .resume-content :global(a) {
    color: var(--text-1);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .resume-content :global(a:hover) {
    opacity: 0.6;
  }

  .resume-content :global(ul) {
    padding-left: 1.25rem;
    margin: 0.25rem 0 0.75rem 0;
  }

  .resume-content :global(li) {
    margin: 0.3rem 0;
    color: var(--text-2);
    line-height: 1.6;
  }

  .resume-content :global(strong) {
    color: var(--text-1);
    font-weight: 600;
  }

  .resume-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.15rem 0.4rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-2);
  }

  .resume-content :global(hr) {
    border: 0;
    height: 1px;
    background: var(--border);
    margin: 1rem 0;
  }

  .resume-content :global(dl) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0.5rem 0;
  }

  .resume-content :global(dd) {
    margin: 0;
    color: var(--text-2);
    padding-left: 1rem;
  }
</style>
